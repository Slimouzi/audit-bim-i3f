# =============================================================================
# Configuration MCP Audit BIM I3F
# =============================================================================

# --- BIMData API : authentification (un des trois modes) -------------------
# Mode 1 — Clé API (recommandé pour scripts backend)
BIMDATA_API_KEY=

# Mode 2 — OAuth2 client_credentials (alternative)
BIMDATA_CLIENT_ID=
BIMDATA_CLIENT_SECRET=

# Mode 3 — Bearer token déjà acquis (typiquement injecté par un viewer)
# BIMDATA_ACCESS_TOKEN=

# --- Endpoints BIMData ------------------------------------------------------
BIMDATA_BASE_URL=https://api.bimdata.io
BIMDATA_IAM_URL=https://iam.bimdata.io/auth/realms/bimdata/protocol/openid-connect/token

# Note : les Smart Views d'audit sont matérialisées en BCF 2.1 Topics
# (endpoint /bcf/2.1/projects/{project_id}/full-topic) — pas de variable
# d'env supplémentaire à configurer.

# --- Cible par défaut (surchargeable via tool MCP set_active_model) --------
BIMDATA_CLOUD_ID=
BIMDATA_PROJECT_ID=
BIMDATA_MODEL_ID=

# --- Documents Maître d'Ouvrage -------------------------------------------
# Chemins par défaut vers les 3 livrables du CCH BIM I3F (surchargeables via
# le tool MCP set_owner_documents).
I3F_CCH_PDF=/Users/stani/code/MCP/Documents maître d'ouvrage/Cahier des annexes CCH Bim I3F V3.6 - Juil 24.pdf
I3F_DATA_SPEC_XLSX=/Users/stani/code/MCP/Documents maître d'ouvrage/Annexe Spécification des données I3F simplifiée - CCH 2021 V3.7 TDB.xlsx
I3F_NAMING_SPEC_XLSX=/Users/stani/code/MCP/Documents maître d'ouvrage/Annexe Nommage IFC 3F CCH 2021 V3.6 SHAB SU.xlsx

# --- Sortie ----------------------------------------------------------------
# Racine des livrables (Word/XLSX/JSON) ET du cache snapshot. DOIT être
# INSCRIPTIBLE. ⚠ En conteneur, le défaut ``./out`` se résout en ``/out`` (CWD=/) ;
# si ce volume est monté en lecture seule, l'audit échoue à l'écriture (Errno 30).
# Pointer vers un chemin monté en écriture (ex. /tmp/audit-out ou un volume dédié).
AUDIT_OUTPUT_DIR=./out

# --- Sécurité (serveur MCP) ------------------------------------------------
# Politique d'écriture BIMData. Non défini → défaut *secure-by-transport* :
# transport LOCAL déclaré (stdio/script : cli, runners, Claude Desktop) = autorisé ;
# réseau (http/sse) OU non déclaré (montage ASGI custom) = REFUSÉ (fail-closed).
# Le flag explicite gagne toujours.
# AUDIT_BIM_ALLOW_WRITES=false
#
# Clé service du serveur (auth des clients MCP en transport réseau).
# AUDIT_BIM_API_KEY=
# Exiger la clé service (implicite en production). true/false.
# AUDIT_BIM_REQUIRE_API_KEY=false
#
# Racine de confinement des fichiers d'ENTRÉE (DOE/CCH/annexes). OBLIGATOIRE
# pour tout transport réseau (sinon refus de démarrer). En stdio/script : optionnel.
# AUDIT_INPUT_DIR=./audit_in
# Taille max (Mo) d'un fichier d'entrée accepté.
# AUDIT_MAX_INPUT_MB=200
# Opt-out du confinement d'entrée en réseau (déconseillé — n'activer qu'avec un
# garde-fou filesystem côté infra : chroot, conteneur, AppArmor).
# AUDIT_BIM_ALLOW_UNBOUNDED_INPUTS=false
#
# Mode de déploiement : production | prod → exige la clé service, autorise 0.0.0.0.
# AUDIT_BIM_ENV=
# Autoriser un Bearer utilisateur passé en PARAMÈTRE de tool (access_token=…).
# Défaut secure-by-transport : local déclaré = autorisé ; réseau/non déclaré = REFUSÉ
# (les args MCP fuient dans les logs client / proxy).
# AUDIT_BIM_ALLOW_ACCESS_TOKEN_PARAM=false
# Durée de vie (s) d'une session HTTP avant expiration/rebind.
# AUDIT_BIM_SESSION_TTL_S=3600
